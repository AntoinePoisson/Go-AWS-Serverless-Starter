# Defaults for local runs and integration tests. Copy to .env to override, it
# wins over this file and a real env var wins over both. Deploys read neither.

STAGE=local
LOG_LEVEL=debug
VERSION=dev

# deployed stages derive the table name from the service name
ITEMS_TABLE=go-aws-serverless-starter-local-items

# local only, deployed stages read the key from SSM
API_KEY=local-dev-key

DYNAMODB_ENDPOINT=http://localhost:8000
API_PORT=8080
PUBLIC_PORT=8081

# required by the SDK, ignored by DynamoDB Local
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
