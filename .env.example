# Defaults for local runs and integration tests. Copy to .env to override: .env
# wins over this file, a real environment variable wins over both, and the
# deployment tasks read neither.

STAGE=local
LOG_LEVEL=debug
VERSION=dev

# Deployed stages derive their table name from the service name.
ITEMS_TABLE=bootstrap-go-aws-local-items

# Local value only; deployed stages read the key from SSM Parameter Store.
API_KEY=local-dev-key

DYNAMODB_ENDPOINT=http://localhost:8000
API_PORT=8080
PUBLIC_PORT=8081

# Required by the AWS SDK, ignored by DynamoDB Local.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
